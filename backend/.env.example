# Copy to .env and fill in. Never commit .env.
# Generate each key with:
#   python3 -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"

FF_ENV=production
DOMAIN=api.futurefashion.example
FF_PUBLIC_BASE_URL=https://api.futurefashion.example

POSTGRES_PASSWORD=change-me-long-random
FF_DATABASE_URL=postgresql+asyncpg://futurefashion:change-me-long-random@postgres:5432/futurefashion
FF_REDIS_URL=redis://redis:6379/0

# Two different random 32-byte keys (base64). Back them up: losing
# FF_DATA_ENCRYPTION_KEY makes stored bank numbers unreadable.
FF_DATA_ENCRYPTION_KEY=
FF_HMAC_KEY=

# Android App Links: the app id and the SHA-256 fingerprint of the
# release signing certificate (see docs/RELEASE.md).
FF_ANDROID_PACKAGE_NAME=com.futurefashion.app
FF_ANDROID_CERT_SHA256=[]

FF_LOG_LEVEL=INFO
