# Copy to .env and fill in. Never commit .env.
# Generate each key with:
#   python3 -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"

FF_ENV=production
# One domain serves the API, referral links (/r/CODE), the APK download and
# the App Links file. The app's WEB_HOST must be this same host.
DOMAIN=futurefashion.example
FF_PUBLIC_BASE_URL=https://futurefashion.example

# Two database roles. The owner runs migrations and owns the tables; the app
# connects as a separate role with only INSERT/SELECT/UPDATE/DELETE (no DROP,
# no DDL, not a superuser). See docs/SECURITY.md.
POSTGRES_PASSWORD=change-me-owner-long-random
# The owner connection (used by the migrate step only):
FF_DATABASE_URL=postgresql+asyncpg://futurefashion:change-me-owner-long-random@postgres:5432/futurefashion
# The app role, created/refreshed by the migrate step and used by api + worker:
APP_DB_USER=futurefashion_app
APP_DB_PASSWORD=change-me-app-long-random
FF_REDIS_URL=redis://redis:6379/0

# Two different random 32-byte keys (base64). Back them up: losing
# FF_DATA_ENCRYPTION_KEY makes stored bank numbers unreadable.
FF_DATA_ENCRYPTION_KEY=
FF_HMAC_KEY=

# Android App Links: the app id and the SHA-256 fingerprint of the
# release signing certificate (see docs/RELEASE.md).
FF_ANDROID_PACKAGE_NAME=com.futurefashion.app
FF_ANDROID_CERT_SHA256=[]

FF_LOG_LEVEL=INFO
