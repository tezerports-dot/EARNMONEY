worker_processes auto;

events {
  worker_connections 1024;
}

http {
  sendfile on;
  client_max_body_size 10m;

  # HTTPS config for a single domain, activated AFTER you've obtained a
  # Let's Encrypt certificate (see "Add HTTPS" in SETUP_GUIDE.md).
  # Replace every occurrence of YOURDOMAIN below with your actual domain
  # (e.g. myreferralapp.duckdns.org) before using this file — the setup
  # guide's sed command does this for you automatically.

  server {
    listen 80 default_server;
    server_name _;
    # Let's Encrypt needs plain HTTP open for renewal checks; everything
    # else gets redirected straight to HTTPS.
    location /.well-known/acme-challenge/ {
      root /var/www/certbot;
    }
    location / {
      return 301 https://$host$request_uri;
    }
  }

  server {
    listen 443 ssl default_server;
    server_name _;

    ssl_certificate     /etc/letsencrypt/live/YOURDOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOURDOMAIN/privkey.pem;

    # Telegram bot webhook
    location /webhook {
      proxy_pass http://bot:3001/webhook;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Everything else (public site + /admin, both served by the same Next.js app)
    location / {
      proxy_pass http://web:3000;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }
  }
}
