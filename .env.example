# Copy this file to .env and fill in real values. Never commit the real .env.

NODE_ENV=production
PORT=3001
CORS_ORIGIN=https://your-domain.example

# --- Database ---------------------------------------------------------------
# In docker-compose this hostname is the service name "postgres", not localhost.
DATABASE_URL=postgresql://job_referral:CHANGE_ME_DB_PASSWORD@postgres:5432/job_referral?schema=public
POSTGRES_USER=job_referral
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=job_referral

# --- Redis (used by future stages: background jobs, distributed rate limiting) ---
REDIS_URL=redis://redis:6379

# --- JWT ---------------------------------------------------------------------
# Generate strong random secrets, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_SECRET
JWT_REFRESH_TTL_DAYS=30

# --- Cookies -------------------------------------------------------------
COOKIE_SECURE=true
COOKIE_DOMAIN=your-domain.example

# --- Argon2id (password hashing) --------------------------------------------
# Defaults are tuned for a Hostinger KVM 2 (8GB RAM). Increase memoryCost if
# you move to a larger VPS plan; watch request latency if you don't.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=20

# --- CAPTCHA (REQUIRED before production — see src/auth/captcha.service.ts) --
# Sign up for Cloudflare Turnstile (free) or hCaptcha and put the secret here.
# Until this is set, signup/login run with NO real CAPTCHA verification.
TURNSTILE_SECRET_KEY=

# --- Identity/KYC provider (stage 3 — not yet wired in) ----------------------
# This platform does not implement its own Aadhaar/ID verification. You need
# a licensed, approved identity verification provider. Do not attempt to
# build direct Aadhaar authentication yourselves — that requires UIDAI
# authorization. Fill these in when that vendor is selected.
IDENTITY_PROVIDER_API_KEY=
IDENTITY_PROVIDER_WEBHOOK_SECRET=

# --- Aadhaar hashing --------------------------------------------------------
# REQUIRED. Keys the HMAC used to de-duplicate Aadhaar numbers. Generate with
# `openssl rand -base64 48`. The raw number is never stored — only this hash
# and the last 4 digits.
#
# Two warnings:
#  * Without it, signup fails closed rather than hashing with an empty key.
#  * Changing it invalidates every existing hash and so silently breaks
#    duplicate detection for all current users. Treat it as permanent.
AADHAAR_HASH_PEPPER=

# --- Telegram bot (stage 3 — not yet wired in) -------------------------------
# Create a bot via https://t.me/BotFather to get this token.
TELEGRAM_BOT_TOKEN=
# Username WITHOUT the @, e.g. bbazaar_bot. Used to build the t.me deep link.
TELEGRAM_BOT_USERNAME=
# Any long random string. Set it here AND pass it as `secret_token` when you
# register the webhook; the API rejects every update that doesn't echo it.
TELEGRAM_WEBHOOK_SECRET=

# --- The two channels every candidate must join to finish verification ------
# Numeric chat IDs (negative). Add the bot as an administrator in BOTH, or it
# cannot read membership. Verification is refused outright while these are
# unset, rather than silently passing everyone through.
TELEGRAM_PUBLIC_CHAT_ID=
TELEGRAM_PRIVATE_CHAT_ID=
# Invite links shown in the app. The private one should be an approval-required
# link — a pending join request is accepted as completing that step.
TELEGRAM_PUBLIC_CHAT_INVITE_LINK=
TELEGRAM_PRIVATE_CHAT_INVITE_LINK=

# --- Selected-candidates group (separate from the two above) ----------------
# Handed out by the API only to candidates who finished both targets. Never
# ship this in the app bundle.
TELEGRAM_SELECTED_GROUP_INVITE_LINK=
