# ---- Telegram Bot ----
# Get this from @BotFather on Telegram after creating your bot.
BOT_TOKEN=
# Your bot's username, without the @ (e.g. MyReferralBot)
BOT_USERNAME=
# Leave BLANK for local development (bot will use long polling).
# Once deployed, set this to your single public domain WITHOUT any path —
# e.g. https://myreferralapp.duckdns.org (a free DuckDNS/FreeDNS/No-IP
# subdomain works fine). The bot code appends /webhook itself, and
# nginx.conf routes https://YOURDOMAIN/webhook to the bot automatically —
# no separate bot subdomain needed.
BOT_WEBHOOK_URL=

# ---- Database ----
# For Docker Compose, "postgres" is the hostname of the postgres service.
DATABASE_URL=postgresql://referral:referral_password@postgres:5432/referral_platform
POSTGRES_PASSWORD=referral_password

# ---- Redis (reserved for future BullMQ use; NOT required right now — the
# bot's session store is in-memory, node-cron does not use Redis either) ----
REDIS_URL=redis://redis:6379

# ---- Deployment mode ----
# "web"      = this process only serves the website (split-services deploy:
#              Oracle VM via docker-compose, or Railway with separate
#              bot/worker/web services). This is the default if unset.
# "combined" = this SAME process also runs the bot webhook + worker cron
#              scheduler in-process. Used for the Railway single-service
#              deployment. See RAILWAY_DEPLOY_GUIDE.md.
RUN_MODE=web

# Set to "true" to pause the bot/worker mid-migration — see MIGRATION_GUIDE.md.
# Every incoming Telegram update gets a "please wait" reply and no DB writes
# happen. Leave "false" (or unset) for normal operation.
MAINTENANCE_MODE=false

# ---- Admin / Web ----
# Used to sign admin login sessions — set this to a long random string.
JWT_SECRET=change_me_to_a_long_random_string
# First admin account credentials — used by "npm run seed:admin" (see README).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_please

# Public URL of your website — same single domain as BOT_WEBHOOK_URL above.
# The admin panel lives at YOURDOMAIN/admin automatically; no separate
# subdomain is needed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Ads (public website only, never shown inside Telegram) ----
ADSENSE_CLIENT=
ADSENSE_SLOT_TOP=
ADSENSE_SLOT_MIDDLE=
ADSENSE_SLOT_BOTTOM=
MONETAG_ZONE_ID=

# ---- Payout bounds (Section 4 of the spec) ----
PAYOUT_MIN_INR=1
PAYOUT_MAX_INR=5
