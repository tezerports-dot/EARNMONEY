# ---------------------------------------------------------------------------
# Referral platform configuration.
# Copy to .env (systemd EnvironmentFile) and fill in real values.
# ---------------------------------------------------------------------------

# Absolute path to the SQLite database file. The parent directory must exist
# and be writable by the service user.
DB_PATH=/opt/referral/data/referral.db

# Password for the /admin panel. Long random string, keep it secret.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Secret used to sign the admin session cookie. Independent from ADMIN_TOKEN so
# that rotating one does not force the other to change.
SESSION_SECRET=change-me-too-another-long-random-string

# Comma separated Telegram user ids allowed to operate the broadcast bot and
# the in-chat moderation commands.
ADMIN_IDS=123456789

# Bots seeded into the database on first start. Format: role:token, comma
# separated. Roles: main, moderation, collector, broadcast.
# After the first start, manage bots from the admin panel instead.
BOT_TOKENS=main:123456:AAExampleTokenForTheMainBot,moderation:123457:AAExampleModerationBot

# Public URL of the web dashboard, used in bot messages.
PUBLIC_BASE_URL=https://referral.example.com

# Two-level payout rates, in INR per active downline member per month.
# Level 1 = people the user invited. Level 2 = people *those* people invited.
# These only seed the database on first boot; after that the admin panel owns
# them and editing this file has no effect.
PAYOUT_LEVEL1=5
PAYOUT_LEVEL2=5

# Hour (0-23, IST) at which the collector bot posts its daily bank-details
# reminder.
DAILY_PROMPT_HOUR=10

# Uvicorn bind address. Keep on loopback and put nginx in front.
HOST=127.0.0.1
PORT=8000
