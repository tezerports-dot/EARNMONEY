{
  "name": "@bbazaar/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "BBAZAAR group of companies — candidate Android app",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "build:apk": "eas build --platform android --profile preview",
    "build:aab": "eas build --platform android --profile production",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "test": "jest",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "expo": "~51.0.28",
    "expo-clipboard": "~6.0.3",
    "expo-linking": "~6.3.1",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "expo-system-ui": "~3.0.0",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.74.5",
    "react-native-google-mobile-ads": "^14.2.4",
    "react-native-safe-area-context": "4.10.5",
    "react-native-web": "^0.19.13"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~18.2.79",
    "@types/react-dom": "~18.2.0",
    "babel-preset-expo": "~11.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.0",
    "playwright-core": "^1.63.0",
    "typescript": "~5.3.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.spec.ts",
      "**/*.spec.tsx"
    ]
  }
}
