generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  JOINING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ShardStatus {
  ACTIVE
  NEAR_CAPACITY
  DISABLED
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

enum AdminRole {
  SUPER_ADMIN
  OPERATOR
  FINANCE
}

model User {
  id               String     @id @default(cuid())
  telegramId       BigInt     @unique
  telegramUsername String?
  languageCode     String?

  phoneNumber  String @unique
  referralCode String @unique

  referredById String?
  referredBy   User?   @relation("UserReferrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("UserReferrals")

  assignedChannelId String?
  assignedChannel   ChannelShard? @relation(fields: [assignedChannelId], references: [id])
  assignedGroupId   String?
  assignedGroup     GroupShard?   @relation(fields: [assignedGroupId], references: [id])

  status     UserStatus @default(PENDING)
  fraudScore Int        @default(0)

  channelJoinedAt   DateTime?
  groupJoinedAt     DateTime?
  channelLastSeenAt DateTime?
  groupLastSeenAt   DateTime?
  activatedAt       DateTime?
  deactivatedAt     DateTime?

  ipHash            String?
  deviceFingerprint String?
  firstSeenAt       DateTime @default(now())

  // Collected via bot /bankdetails command — never via the website
  bankAccountHolder String?
  bankAccountNumber String?
  bankIfsc          String?
  bankUpiId         String?

  // Snapshot cache, refreshed once every 24h by the worker's daily sweep.
  // The public website and /status read these instead of computing live
  // counts on every request.
  cachedActiveReferralCount         Int       @default(0)
  cachedPayoutEligibleReferralCount Int       @default(0)
  statusCachedAt                    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  monthlyPayouts MonthlyPayout[]

  @@index([referredById])
  @@index([status])
  @@index([assignedChannelId])
  @@index([assignedGroupId])
}

model ChannelShard {
  id             String      @id @default(cuid())
  shardKey       String      @unique
  telegramChatId BigInt      @unique
  inviteLink     String
  memberCount    Int         @default(0)
  capacityLimit  Int         @default(1000000)
  nearCapacityAt Int         @default(950000)
  status         ShardStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())

  users User[]

  @@index([status, memberCount])
}

model GroupShard {
  id             String      @id @default(cuid())
  shardKey       String      @unique
  telegramChatId BigInt      @unique
  inviteLink     String
  memberCount    Int         @default(0)
  capacityLimit  Int         @default(200000)
  nearCapacityAt Int         @default(180000)
  status         ShardStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())

  users User[]

  @@index([status, memberCount])
}

// One row per user per calendar month
model MonthlyPayout {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  month               String  @db.VarChar(7) // "YYYY-MM"
  activeReferralCount Int
  ratePerReferralInr  Decimal @db.Decimal(4, 2)
  totalAmountInr      Decimal @db.Decimal(10, 2)

  status              PayoutStatus @default(PENDING)
  bankAccountSnapshot Json?
  transactionRef      String?
  paidByAdminId       String?
  paidByAdmin         AdminUser?   @relation(fields: [paidByAdminId], references: [id])
  paidAt              DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, month])
  @@index([month, status])
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         AdminRole @default(OPERATOR)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  payoutsHandled MonthlyPayout[]
  auditLogs      AuditLog[]
}

model AuditLog {
  id         String     @id @default(cuid())
  adminId    String?
  admin      AdminUser? @relation(fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime   @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
}
