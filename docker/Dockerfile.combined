### Combined image for the Railway single-service deployment.
### Runs bot webhook + worker scheduler + website all in ONE process.
### For the split (multi-service) deployment, use Dockerfile.bot /
### Dockerfile.web instead — no code changes needed either way.
FROM node:20-slim AS base
WORKDIR /repo
RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

FROM base AS deps
COPY package.json ./
COPY packages/database/package.json packages/database/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY apps/bot/package.json apps/bot/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm install

FROM deps AS build
COPY packages/database packages/database
COPY packages/shared packages/shared
COPY apps/bot apps/bot
COPY apps/web apps/web
RUN npm run build -w packages/shared
RUN npm run build -w packages/database
RUN npm run build -w apps/bot
RUN npm run build -w apps/web

FROM base AS runtime
ENV NODE_ENV=production
ENV RUN_MODE=combined
COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/package.json ./package.json
COPY --from=build /repo/packages/database ./packages/database
COPY --from=build /repo/packages/shared ./packages/shared
COPY --from=build /repo/apps/bot ./apps/bot
COPY --from=build /repo/apps/web ./apps/web

# One-off Prisma schema push, then hand off to the combined server. Railway
# runs this as the container's own startup — no separate "migrate" service
# needed (that only exists in the split/docker-compose deployment).
WORKDIR /repo
CMD ["sh", "-c", "npx prisma db push --skip-generate --accept-data-loss --schema packages/database/prisma/schema.prisma && node apps/web/server.js"]
